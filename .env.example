# --- Required ---

# Local dev: a Postgres you run yourself.
# Hosting: use the POOLED connection string (serverless opens many short-lived
# connections; a direct connection will exhaust Postgres).
DATABASE_URL="postgresql://USER@localhost:5432/scalespeisekarte?schema=public"

# openssl rand -base64 32
AUTH_SECRET=""

# --- Optional ---

# Only for local dev. LEAVE THIS UNSET when hosting: the app then derives the
# origin from the incoming request, so QR codes point at your real domain.
# Setting it to a localhost value in production makes every printed QR code
# point at localhost.
NEXT_PUBLIC_APP_URL="http://localhost:3100"

# Without it the app runs unchanged and the AI features hide themselves.
# Needed for: menu import from PDF/photo, and the AI look designer.
ANTHROPIC_API_KEY=""

# Bild-Uploads. Lokal nicht nötig: ohne Token landen Bilder in public/uploads.
# Auf Vercel zwingend — das Dateisystem dort ist schreibgeschützt. Im Dashboard
# unter Storage einen Blob-Store anlegen, Vercel setzt die Variable dann selbst.
BLOB_READ_WRITE_TOKEN=""
